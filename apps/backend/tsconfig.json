{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    /* --- ОБЯЗАТЕЛЬНО ДЛЯ TYPEORM --- */
    "experimentalDecorators": true, // Включает поддержку legacy-декораторов
    "emitDecoratorMetadata": true, // Заставляет TS генерировать метаданные типов для reflect-metadata
    "useDefineForClassFields": false // Без этого поля сущностей будут затираться
  },
  "include": [
    "src/**/*",
    "../../apps/shared/src/**/*"
  ]
}