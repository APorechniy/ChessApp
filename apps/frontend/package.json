{
  "name": "@app/frontend",
  "version": "1.0.0",
  "description": "Frontend service for ChessManagerApp",
  "author": "APorechniy",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "CROSS-ENV NODE_ENV=development next dev -p 8080",
    "dev:docker": "next dev -p 3000",
    "ai:index": "npx tsx .ai-copilot/ingest.ts",
    "ai:work": "npx tsx .ai-copilot/codegen.ts",
    "build": "next build",
    "build:production": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:e2e": "cypress run --e2e",
    "cy:run:component": "cypress run --component",
    "test:e2e": "start-server-and-test dev http://localhost:8080 cy:run:e2e",
    "test:e2e:open": "start-server-and-test dev http://localhost:8080 cy:open"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@reduxjs/toolkit": "^2.6.1",
    "axios": "^1.8.4",
    "chess.js": "^1.4.0",
    "framer-motion": "^12.42.2",
    "luxon": "^3.7.2",
    "next": "15.0.0",
    "react": "^19.0.0",
    "react-calendar": "^6.0.0",
    "react-chessboard": "^5.10.0",
    "react-data-table-component": "^7.7.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.5.0",
    "redux-persist": "^6.0.0",
    "styled-components": "^6.1.17"
  },
  "devDependencies": {
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@testing-library/cypress": "^10.1.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "22.15.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^15.13.0",
    "dotenv": "^17.4.2",
    "globals": "^15.15.0",
    "openai": "^6.45.0",
    "start-server-and-test": "^3.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "undici": "^8.6.0"
  }
}
